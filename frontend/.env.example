# Feblio · frontend (Vite). Solo variables públicas: todo VITE_* acaba en el bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# URL pública de la app (Railway hoy; feblio.com cuando se conecte el dominio)
VITE_APP_URL=http://localhost:5173

# --- Modo demo (SOLO desarrollo local; desactivado por defecto y en producción) ---
# Con VITE_DEMO_MODE=true la landing muestra tres botones etiquetados Admin, Empresa y
# Cliente. Los emails se toman de VITE_DEMO_ACCOUNTS (nunca del código) y NO se muestran
# en pantalla. No hay contraseñas ni login automático: se escriben manualmente.
# Formato: Etiqueta:email,Etiqueta:email,Etiqueta:email
# VITE_DEMO_MODE=true
# VITE_DEMO_ACCOUNTS=Admin:admin@example.com,Empresa:empresa@example.com,Cliente:cliente@example.com
